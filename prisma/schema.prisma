generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Invitation {
  id                  String     @id @default(cuid())
  invitationCode      String     @unique
  invitedToFriday     Boolean    @default(false)
  invitedToSaturday   Boolean    @default(true)
  invitedToSunday     Boolean    @default(false)
  rsvpStatus          RsvpStatus @default(PENDING)
  rsvpSubmittedAt     DateTime?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  guests              Guest[]
}

model Guest {
  id               String          @id @default(cuid())
  firstName        String
  lastName         String
  email            String?
  guestType        GuestType       @default(NAMED_GUEST)
  fridayResponse   Response?
  saturdayResponse Response?
  sundayResponse   Response?
  dinnerRequest    MealPreference?
  dietaryRestrictions String?
  notes               String?
  invitationId     String
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  invitation       Invitation      @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@index([firstName, lastName])
}

enum GuestType {
  NAMED_GUEST
  PLUS_ONE
}

enum RsvpStatus {
  PENDING
  COMPLETED
}

enum Response {
  YES
  NO
}

enum MealPreference {
  CHICKEN
  SALMON
  VEGETARIAN
}
